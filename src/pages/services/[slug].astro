---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import Contact from '../../components/sections/Contact.astro';
import PhotoGallery from '../../components/service/PhotoGallery.astro';
import SystemShowcase from '../../components/service/SystemShowcase.astro';
import ExplodedView from '../../components/service/ExplodedView.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import IndustryDemos from '../../components/service/IndustryDemos.astro';
import { services } from '../../content/services';
import type { Service } from '../../content/types';
import '../../styles/service.css';

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<Base title={service.title} description={service.intro}>
  <Header />
  <main id="main-content">
    <ServiceHero service={service} />

    {service.slug === 'robotics' && <ExplodedView />}

    <IndustryDemos service={service.slug} />

    {service.systems && (
      <SystemShowcase
        systems={service.systems}
        serviceTitle={service.title}
        slug={service.slug}
      />
    )}

    {service.gallery && <PhotoGallery service={service} />}

    <Contact need={service.slug} />
  </main>
  <Footer />
</Base>
