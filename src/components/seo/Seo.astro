---
/**
 * All <head> SEO/social tags. Codex drops `<Seo />` into Base.astro's <head>; pages pass overrides.
 *   <Seo />                                     home: default title + description
 *   <Seo title="Privacy Notice" description="…" />
 * Absolute URLs (canonical, og:url, og:image) need `site` (PUBLIC_SITE_URL or the Vercel URL);
 * without it those tags are omitted rather than emitted wrong.
 */
import JsonLd from './JsonLd.astro';
import {
  absoluteUrl,
  allowIndexing,
  formatTitle,
  organizationJsonLd,
  siteMeta,
  websiteJsonLd,
} from '../../lib/seo';

interface Props {
  /** Page title without the brand suffix. Omit on the home page. */
  title?: string;
  description?: string;
  image?: { src: string; width: number; height: number; alt: string };
  /** Force noindex for this page (e.g. thank-you or 404). */
  noindex?: boolean;
  /** Emit Organization + WebSite JSON-LD (home page only). */
  structuredData?: boolean;
}

const {
  title,
  description = siteMeta.description,
  image = siteMeta.ogImage,
  noindex = false,
  structuredData = !title,
} = Astro.props;

const site = Astro.site;
const fullTitle = formatTitle(title);
const canonical = absoluteUrl(Astro.url.pathname, site);
const imageUrl = absoluteUrl(image.src, site);
const robots =
  allowIndexing && !noindex ? 'index, follow' : 'noindex, nofollow';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{canonical && <link rel="canonical" href={canonical} />}
<meta name="theme-color" content={siteMeta.themeColor} />
<meta name="color-scheme" content="dark" />
{site && <link rel="sitemap" href="/sitemap-index.xml" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteMeta.name} />
<meta property="og:locale" content={siteMeta.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{imageUrl && (
  <>
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

{structuredData && (
  <JsonLd data={[organizationJsonLd(site), websiteJsonLd(site)]} />
)}
