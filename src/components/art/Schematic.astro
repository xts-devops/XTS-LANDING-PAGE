---
/**
 * Gold-line system schematics — XTS draws the systems it builds instead of using stock photos.
 * Canvas 600×400, `slice` scaling. Subjects stay inside the safe area x 140–460 / y 70–330, so
 * every crop the layout uses (16:7 … 4:5) keeps them whole. `data-draw` paths animate in (MOTION §7).
 */
import '../../styles/art.css';

import type { ArtName } from '../../content/types';

interface Props {
  name: ArtName;
}
const { name } = Astro.props;
const uid = `sx-${name}`;

// Small helpers keep repeated marks declarative.
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const bars = [38, 62, 48, 84, 70, 104, 92];
---

<svg
  class="sx"
  viewBox="0 0 600 400"
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id={`${uid}-grid`}
      width="24"
      height="24"
      patternUnits="userSpaceOnUse"
    >
      <path class="sx-grid" d="M24 0H0V24" />
    </pattern>
  </defs>
  <rect width="600" height="400" fill={`url(#${uid}-grid)`} opacity="0.55" />

  {name === 'platforms' && (
    <g>
      {/* POS tablet */}
      <rect class="sx-frame" x="146" y="118" width="150" height="172" rx="12" />
      <rect class="sx-panel" x="156" y="130" width="130" height="118" rx="4" />
      {range(9).map((i) => (
        <rect
          class={i === 4 ? 'sx-tint' : 'sx-bar'}
          x={164 + (i % 3) * 40}
          y={138 + Math.floor(i / 3) * 34}
          width="34"
          height="28"
          rx="3"
        />
      ))}
      <rect
        class="sx-ink"
        x="156"
        y="256"
        width="130"
        height="22"
        rx="4"
        opacity="0.9"
      />
      {/* stand */}
      <path class="sx-dim" d="M206 290 L196 316 H246 L236 290" />
      {/* dashboard monitor */}
      <rect class="sx-frame" x="318" y="92" width="144" height="172" rx="8" />
      <rect class="sx-bar" x="332" y="106" width="56" height="6" rx="3" />
      {bars.slice(0, 6).map((h, i) => (
        <rect
          class="sx-ink"
          x={334 + i * 20}
          y={210 - h * 0.85}
          width="11"
          height={h * 0.85}
          rx="2"
          opacity={0.45 + i * 0.09}
        />
      ))}
      <path class="sx-dim" d="M332 214 H448" />
      {range(3).map((i) => (
        <g>
          <rect
            class="sx-bar"
            x="332"
            y={226 + i * 12}
            width={70 - i * 12}
            height="5"
            rx="2.5"
          />
          <rect
            class="sx-bar"
            x="420"
            y={226 + i * 12}
            width="28"
            height="5"
            rx="2.5"
          />
        </g>
      ))}
      <path class="sx-soft sx-dash" d="M296 200 C 306 200 308 180 318 180" />
      <path
        class="sx-flow"
        pathLength="100"
        d="M296 200 C 306 200 308 180 318 180"
      />
      <path class="sx-dim" d="M120 316 H480" />
    </g>
  )}

  {name === 'software' && (
    <g>
      <rect class="sx-frame" x="144" y="84" width="296" height="232" rx="10" />
      <path class="sx-dim" d="M144 108 H440" />
      {range(3).map((i) => (
        <circle
          cx={160 + i * 12}
          cy="96"
          r="3.5"
          class={i === 0 ? 'sx-ink' : 'sx-bar'}
        />
      ))}
      {[
        [0, 110, 0],
        [1, 70, 1],
        [1, 130, 0],
        [2, 90, 0],
        [2, 40, 1],
        [1, 150, 0],
        [0, 60, 1],
        [1, 100, 0],
        [2, 120, 0],
        [0, 80, 0],
      ].map(([indent, w, gold], i) => (
        <g>
          <rect
            class="sx-bar"
            x="156"
            y={124 + i * 18}
            width="10"
            height="5"
            rx="2"
            opacity="0.6"
          />
          <rect
            class={gold ? 'sx-ink' : 'sx-bar'}
            x={180 + indent * 16}
            y={124 + i * 18}
            width={w}
            height="5"
            rx="2.5"
            opacity={gold ? 0.85 : 1}
          />
        </g>
      ))}
      <rect class="sx-ink-hi" x="262" y="268" width="2" height="12" />
      {/* phone build */}
      <rect class="sx-frame" x="392" y="176" width="82" height="150" rx="12" />
      <rect class="sx-tint" x="402" y="192" width="62" height="40" rx="5" />
      {range(4).map((i) => (
        <rect
          class="sx-bar"
          x="402"
          y={242 + i * 16}
          width={62 - (i % 2) * 18}
          height="8"
          rx="3"
        />
      ))}
      <path
        class="sx-gold"
        data-draw
        d="M402 222 L418 210 L432 216 L448 200 L464 204"
      />
    </g>
  )}

  {name === 'automation' && (
    <g>
      {[
        ['M206 128 C 248 128 250 200 290 200', true],
        ['M206 200 H290', false],
        ['M206 272 C 248 272 250 200 290 200', true],
        ['M310 200 C 350 200 352 136 394 136', true],
        ['M310 200 H394', false],
        ['M310 200 C 350 200 352 264 394 264', true],
      ].map(([d]) => (
        <g>
          <path class="sx-soft" d={d as string} />
          <path class="sx-flow" pathLength="100" d={d as string} />
        </g>
      ))}
      {[
        [146, 112, 'POS'],
        [146, 184, 'CRM'],
        [146, 256, 'E-COM'],
        [394, 120, 'ERP'],
        [394, 184, 'WMS'],
        [394, 248, 'REPORTS'],
      ].map(([x, y, label]) => (
        <g>
          <rect class="sx-node" x={x} y={y} width="60" height="32" rx="7" />
          <text
            class="sx-label"
            x={(x as number) + 30}
            y={(y as number) + 19}
            text-anchor="middle"
          >
            {label}
          </text>
        </g>
      ))}
      <circle class="sx-tint sx-pulse" cx="300" cy="200" r="18" />
      <circle class="sx-hub" cx="300" cy="200" r="20" />
      <path class="sx-gold" d="M292 200 L298 206 L309 193" />
    </g>
  )}

  {name === 'robotics' && (
    <g>
      <path class="sx-soft sx-dash" d="M208 300 A 140 140 0 0 1 430 170" />
      <path class="sx-dim" d="M150 322 H450" />
      <rect class="sx-panel" x="226" y="290" width="76" height="32" rx="4" />
      <path class="sx-gold" data-draw d="M264 290 L264 262 L330 168 L404 196" />
      <circle class="sx-hub" cx="264" cy="262" r="12" />
      <circle class="sx-hub" cx="330" cy="168" r="10" />
      <circle class="sx-node" cx="404" cy="196" r="7" />
      <path class="sx-gold" d="M404 203 L398 222 M404 203 L414 220" />
      <rect class="sx-tint" x="390" y="224" width="30" height="24" rx="2" />
      <rect class="sx-soft" x="390" y="224" width="30" height="24" rx="2" />
      {/* dimension lines */}
      <path class="sx-dim" d="M170 262 H242 M170 256 V268 M242 256 V268" />
      <text class="sx-label" x="206" y="252" text-anchor="middle">
        J1
      </text>
      <path class="sx-dim" d="M340 120 L410 150" />
      <text class="sx-label sx-label-gold" x="414" y="146">
        REACH
      </text>
      <circle class="sx-ink sx-pulse" cx="404" cy="196" r="3" />
    </g>
  )}

  {name === 'retail-ops' && (
    <g>
      <rect class="sx-frame" x="196" y="118" width="208" height="164" rx="10" />
      {range(3).map((i) => (
        <g>
          <rect
            class="sx-panel"
            x={208 + i * 64}
            y="132"
            width="56"
            height="40"
            rx="5"
          />
          <rect
            class="sx-bar"
            x={216 + i * 64}
            y="142"
            width="26"
            height="5"
            rx="2.5"
          />
          <rect
            class={i === 1 ? 'sx-ink' : 'sx-bar'}
            x={216 + i * 64}
            y="154"
            width="38"
            height="8"
            rx="3"
          />
        </g>
      ))}
      <path class="sx-dim" d="M210 262 H390" />
      <path
        class="sx-gold"
        data-draw
        d="M212 250 L240 236 L268 242 L296 214 L324 222 L352 196 L388 190"
      />
      <path
        class="sx-tint"
        d="M212 250 L240 236 L268 242 L296 214 L324 222 L352 196 L388 190 V262 H212 Z"
      />
      {[
        [300, 62, 'M300 86 V118'],
        [154, 300, 'M178 296 C 196 296 196 282 214 282'],
        [446, 300, 'M422 296 C 404 296 404 282 386 282'],
      ].map(([x, y, d]) => (
        <g>
          <path class="sx-soft" d={d as string} />
          <path class="sx-flow" pathLength="100" d={d as string} />
          <rect
            class="sx-node"
            x={(x as number) - 24}
            y={(y as number) - 12}
            width="48"
            height="24"
            rx="6"
          />
          <path
            class="sx-gold"
            d={`M${(x as number) - 10} ${(y as number) - 2} h20 M${(x as number) - 8} ${(y as number) + 4} h16`}
          />
        </g>
      ))}
      <text class="sx-label" x="300" y="342" text-anchor="middle">
        BRANCHES IN SYNC
      </text>
    </g>
  )}

  {name === 'warehouse' && (
    <g>
      {range(3).map((c) => (
        <g>
          <rect
            class="sx-panel"
            x={156 + c * 104}
            y="96"
            width="80"
            height="208"
            rx="3"
          />
          {range(5).map((r) => (
            <g>
              <path
                class="sx-dim"
                d={`M${156 + c * 104} ${96 + (r + 1) * 41.6} h80`}
              />
              {range(3).map((b) => (
                <rect
                  class={(c + r + b) % 5 === 0 ? 'sx-ink' : 'sx-bar'}
                  x={162 + c * 104 + b * 24}
                  y={96 + r * 41.6 + 18}
                  width="18"
                  height="20"
                  rx="2"
                  opacity={(c + r + b) % 5 === 0 ? 0.85 : 1}
                />
              ))}
            </g>
          ))}
        </g>
      ))}
      <path
        class="sx-gold sx-dash"
        data-draw
        d="M150 330 H248 V80 H352 V330 H446"
      />
      <circle class="sx-ink" cx="150" cy="330" r="4" />
      <circle class="sx-hub sx-pulse" cx="446" cy="330" r="5" />
      <circle class="sx-hub" cx="446" cy="330" r="5" />
    </g>
  )}

  {name === 'production-cell' && (
    <g>
      <path class="sx-dim" d="M140 286 H460 M140 306 H460" />
      {range(9).map((i) => (
        <circle class="sx-node" cx={152 + i * 37} cy="296" r="7" />
      ))}
      {range(3).map((i) => (
        <rect
          class={i === 1 ? 'sx-tint' : 'sx-panel'}
          x={170 + i * 90}
          y="258"
          width="34"
          height="28"
          rx="2"
        />
      ))}
      <rect class="sx-soft" x="260" y="258" width="34" height="28" rx="2" />
      <path class="sx-gold" data-draw d="M330 92 V122 L300 188 L278 236" />
      <rect class="sx-panel" x="306" y="76" width="48" height="16" rx="3" />
      <circle class="sx-hub" cx="330" cy="122" r="9" />
      <circle class="sx-hub" cx="300" cy="188" r="8" />
      <path class="sx-gold" d="M278 236 L270 252 M278 236 L288 251" />
      {/* status panel */}
      <rect class="sx-frame" x="150" y="98" width="110" height="86" rx="8" />
      {range(3).map((i) => (
        <g>
          <circle
            class={i < 2 ? 'sx-ink' : 'sx-bar'}
            cx="166"
            cy={118 + i * 18}
            r="4"
          />
          <rect
            class="sx-bar"
            x="178"
            y={115 + i * 18}
            width={56 - i * 10}
            height="6"
            rx="3"
          />
        </g>
      ))}
      <circle class="sx-ink sx-pulse" cx="166" cy="118" r="4" />
      {/* sensor waves */}
      <path
        class="sx-soft"
        d="M398 190 a 20 20 0 0 1 0 40 M410 180 a 32 32 0 0 1 0 60"
      />
      <circle class="sx-node" cx="392" cy="210" r="6" />
    </g>
  )}

  {name === 'industry-retail' && (
    <g>
      <path class="sx-gold" data-draw d="M226 168 L238 132 H362 L374 168" />
      {range(5).map((i) => (
        <path class="sx-soft" d={`M${238 + i * 25} 132 L${232 + i * 28} 168`} />
      ))}
      <path
        class="sx-dim"
        d="M226 168 Q 239 184 252 168 Q 265 184 278 168 Q 291 184 304 168 Q 317 184 330 168 Q 343 184 356 168 Q 365 180 374 168"
      />
      <rect class="sx-frame" x="236" y="184" width="128" height="104" rx="3" />
      <rect class="sx-panel" x="250" y="208" width="44" height="80" rx="2" />
      <rect class="sx-tint" x="306" y="204" width="44" height="40" rx="2" />
      <rect class="sx-soft" x="306" y="204" width="44" height="40" rx="2" />
      <path class="sx-dim" d="M160 288 H440" />
      {[160, 440].map((x) => (
        <g>
          <circle class="sx-node" cx={x} cy="236" r="16" />
          <path class="sx-gold" d={`M${x - 6} ${236 - 2} h12 l-2 10 h-8 z`} />
        </g>
      ))}
      <path class="sx-flow" pathLength="100" d="M176 236 H236" />
      <path class="sx-flow" pathLength="100" d="M364 236 H424" />
    </g>
  )}

  {name === 'industry-manufacturing' && (
    <g>
      <g class="sx-gold">
        <circle cx="260" cy="176" r="46" />
        <circle cx="260" cy="176" r="16" />
        {range(8).map((i) => (
          <rect
            x="252"
            y="118"
            width="16"
            height="16"
            rx="2"
            transform={`rotate(${i * 45} 260 176)`}
          />
        ))}
      </g>
      <g class="sx-soft">
        <circle cx="354" cy="230" r="30" />
        <circle cx="354" cy="230" r="10" />
        {range(6).map((i) => (
          <rect
            x="348"
            y="192"
            width="12"
            height="12"
            rx="2"
            transform={`rotate(${i * 60} 354 230)`}
          />
        ))}
      </g>
      <path class="sx-dim" d="M150 296 H450 M150 316 H450" />
      {range(4).map((i) => (
        <rect
          class={i === 2 ? 'sx-tint' : 'sx-panel'}
          x={176 + i * 72}
          y="270"
          width="30"
          height="26"
          rx="2"
        />
      ))}
      <path class="sx-flow" pathLength="100" d="M150 306 H450" />
    </g>
  )}

  {name === 'industry-logistics' && (
    <g>
      <path
        class="sx-soft sx-dash"
        d="M150 290 C 210 290 210 170 280 170 S 360 250 450 110"
      />
      <path
        class="sx-flow"
        pathLength="100"
        d="M150 290 C 210 290 210 170 280 170 S 360 250 450 110"
      />
      {[
        [150, 290],
        [280, 170],
        [450, 110],
      ].map(([x, y], i) => (
        <g>
          <path
            class={i === 2 ? 'sx-gold' : 'sx-soft'}
            d={`M${x} ${y} c -10 -12 -12 -26 0 -30 c 12 4 10 18 0 30 z`}
          />
          <circle
            class={i === 2 ? 'sx-ink' : 'sx-bar'}
            cx={x}
            cy={y - 21}
            r="3.5"
          />
        </g>
      ))}
      <circle class="sx-ink sx-pulse" cx="450" cy="89" r="3.5" />
      {/* warehouse + truck */}
      <path class="sx-frame" d="M318 312 V262 L362 240 L406 262 V312 Z" />
      <rect class="sx-panel" x="346" y="280" width="32" height="32" />
      <rect class="sx-frame" x="168" y="198" width="54" height="30" rx="3" />
      <rect class="sx-frame" x="222" y="208" width="22" height="20" rx="3" />
      <circle class="sx-node" cx="184" cy="230" r="6" />
      <circle class="sx-node" cx="232" cy="230" r="6" />
    </g>
  )}

  {name === 'industry-healthcare' && (
    <g>
      <rect class="sx-frame" x="232" y="92" width="136" height="216" rx="10" />
      <rect class="sx-panel" x="276" y="84" width="48" height="18" rx="5" />
      {range(5).map((i) => (
        <g>
          <rect
            class={i < 3 ? 'sx-tint' : 'sx-panel'}
            x="248"
            y={124 + i * 34}
            width="16"
            height="16"
            rx="3"
          />
          {i < 3 && (
            <path class="sx-gold" d={`M251 ${132 + i * 34} l4 4 l7 -8`} />
          )}
          <rect
            class="sx-bar"
            x="274"
            y={129 + i * 34}
            width={76 - (i % 3) * 14}
            height="6"
            rx="3"
          />
        </g>
      ))}
      <circle class="sx-hub" cx="170" cy="200" r="24" />
      <path class="sx-gold" d="M170 188 V212 M158 200 H182" />
      <circle class="sx-tint sx-pulse" cx="170" cy="200" r="22" />
      <path class="sx-soft" d="M194 200 H232" />
      <path class="sx-flow" pathLength="100" d="M194 200 H232" />
      {range(3).map((i) => (
        <rect
          class={i === 1 ? 'sx-tint' : 'sx-panel'}
          x="394"
          y={150 + i * 40}
          width="52"
          height="32"
          rx="3"
        />
      ))}
      <path class="sx-soft" d="M368 200 H394" />
    </g>
  )}

  {name === 'industry-government' && (
    <g>
      <path class="sx-gold" data-draw d="M186 150 L270 106 L354 150 Z" />
      <path class="sx-dim" d="M190 162 H350" />
      {range(4).map((i) => (
        <rect
          class="sx-panel"
          x={202 + i * 38}
          y="168"
          width="16"
          height="104"
          rx="2"
        />
      ))}
      <path class="sx-dim" d="M182 278 H358 M174 290 H366 M166 302 H374" />
      <rect class="sx-frame" x="388" y="140" width="72" height="96" rx="6" />
      {range(4).map((i) => (
        <rect
          class={i === 0 ? 'sx-ink' : 'sx-bar'}
          x="400"
          y={156 + i * 16}
          width={48 - (i % 2) * 14}
          height="6"
          rx="3"
        />
      ))}
      <path class="sx-soft" d="M360 200 C 372 200 376 188 388 188" />
      <path
        class="sx-flow"
        pathLength="100"
        d="M360 200 C 372 200 376 188 388 188"
      />
      <circle class="sx-ink sx-pulse" cx="270" cy="128" r="3" />
    </g>
  )}
</svg>
