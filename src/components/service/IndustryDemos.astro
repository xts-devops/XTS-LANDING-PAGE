---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Screen from '../media/Screen.astro';
import {
  industryDemos,
  industryCopy as copy,
} from '../../content/industry-demos';
import '../../styles/industry.css';
interface Props {
  service: string;
}
const journeyUrls: Record<string, string> = {
  vista: '/demos/tours/property.html',
  daybreak: '/demos/tours/hotel.html',
};
const demos = industryDemos.filter((d) => d.service === Astro.props.service);
---

{demos.length > 0 && (
  <section
    class="section industry-demos"
    id="industry-demos"
    aria-labelledby="industry-heading"
  >
    <Container>
      <div class="industry-head" data-scroll-start>
        <div>
          <Eyebrow>{copy.eyebrow}</Eyebrow>
          <h2 id="industry-heading">{copy.heading}</h2>
        </div>
        <p>{copy.summary}</p>
      </div>
      <ul
        class:list={[
          'industry-grid',
          {
            'industry-grid-single': demos.length === 1,
            'industry-grid-pairs': demos.length === 4,
            'industry-grid-five': demos.length === 5,
          },
        ]}
        role="list"
      >
        {demos.map((d) => (
          <li
            class="industry-card"
            data-overview={d.id}
            data-overview-url={`${journeyUrls[d.id] ?? `/demos/${d.id}.html`}?preview=1`}
            data-journey-preview={journeyUrls[d.id] ? 'true' : undefined}
            data-title={d.title}
            data-idle-label={copy.previewLabel}
            data-loading-label={copy.loading}
            data-complete-label={copy.complete}
            data-failure-label={copy.unavailable}
          >
            <div class="industry-thumb" data-overview-stage>
              <div class="overview-media">
                <Screen
                  screen={`industry/${d.id}`}
                  alt={`${d.title}: sample system interface`}
                  sizes="(min-width: 1024px) 32vw, 100vw"
                  widths={[480, 800]}
                />
                <div
                  class="overview-live"
                  data-overview-live
                  aria-hidden="true"
                  inert
                ></div>
              </div>
              <div class="overview-toolbar">
                <p
                  class="overview-status"
                  data-overview-status
                  aria-hidden="true"
                >
                  {copy.previewLabel}
                </p>
                {journeyUrls[d.id] && (
                  <button
                    type="button"
                    class="overview-control overview-motion-control"
                    data-journey-toggle
                    data-pause-label={copy.pausePreview}
                    data-resume-label={copy.resumePreview}
                    data-pause-text={copy.pause}
                    data-resume-text={copy.resume}
                    aria-label={copy.pausePreview}
                    aria-pressed="false"
                    hidden
                  >
                    <span>{copy.pause}</span>
                  </button>
                )}
                <button
                  type="button"
                  class="overview-control"
                  data-overview-open
                  aria-haspopup="dialog"
                  aria-controls="overview-dialog"
                  aria-label={`${copy.fullscreen}: ${d.title}`}
                >
                  <Icon name="arrow-up-right" />
                  <span>{copy.fullscreen}</span>
                </button>
              </div>
            </div>
            <template data-overview-poster>
              <Screen
                screen={`industry/${d.id}`}
                alt={`${d.title}: sample system interface`}
                sizes="100vw"
                widths={[1440, 2880]}
                format="webp"
                eager
              />
            </template>
            <div class="industry-card-body">
              <p class="industry-category">{d.industry}</p>
              <h3>{d.title}</h3>
              <p>{d.summary}</p>
              <ul class="industry-capabilities" role="list">
                {d.capabilities.map((c) => (
                  <li>
                    <Icon name="shield-check" />
                    {c}
                  </li>
                ))}
              </ul>
              <noscript>
                <a
                  class="overview-fallback"
                  href={journeyUrls[d.id] ?? `/demos/${d.id}.html`}
                >
                  {copy.fallback}
                </a>
              </noscript>
            </div>
          </li>
        ))}
      </ul>
      <dialog
        id="overview-dialog"
        class="overview-dialog"
        data-overview-dialog
        aria-labelledby="overview-dialog-title"
        data-actual-label={copy.actual}
        data-fit-label={copy.fit}
      >
        <header class="overview-dialog-head">
          <h2 id="overview-dialog-title" data-overview-title></h2>
          <div class="overview-dialog-actions">
            <button type="button" data-overview-size aria-pressed="false">
              {copy.actual}
            </button>
            <button type="button" data-overview-close>
              {copy.close}
              <span aria-hidden="true">×</span>
            </button>
          </div>
        </header>
        <div
          class="overview-inspect"
          data-overview-inspect
          tabindex="0"
          role="region"
          aria-label={copy.inspect}
        >
          <div class="overview-expanded-surface">
            <div class="overview-expanded-canvas">
              <div
                class="overview-expanded-poster"
                data-overview-expanded-poster
              ></div>
              <div
                class="overview-expanded-live"
                data-overview-expanded-live
                aria-hidden="true"
                inert
              ></div>
            </div>
          </div>
        </div>
        <footer class="overview-dialog-footer">
          <p data-overview-dialog-status aria-hidden="true">
            {copy.previewLabel}
          </p>
          <p>{copy.note}</p>
        </footer>
      </dialog>
      <div class="industry-footer">
        <p>{copy.note}</p>
        <a href="#systems">
          {copy.modules}
          <Icon name="arrow-right" />
        </a>
      </div>
    </Container>
  </section>
)}
