---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Screen from '../media/Screen.astro';
import {
  industryDemos,
  industryCopy as copy,
} from '../../content/industry-demos';
import '../../styles/industry.css';
interface Props {
  service: string;
}
const demos = industryDemos.filter((d) => d.service === Astro.props.service);
---

{demos.length > 0 && (
  <section
    class="section industry-demos"
    id="industry-demos"
    aria-labelledby="industry-heading"
  >
    <Container>
      <div class="industry-head" data-scroll-start>
        <div>
          <Eyebrow>{copy.eyebrow}</Eyebrow>
          <h2 id="industry-heading">{copy.heading}</h2>
        </div>
        <p>{copy.summary}</p>
      </div>
      <ul
        class:list={[
          'industry-grid',
          {
            'industry-grid-single': demos.length === 1,
            'industry-grid-pairs': demos.length === 4,
          },
        ]}
        role="list"
      >
        {demos.map((d) => (
          <li class="industry-card" data-overview={d.id}>
            <div class="industry-thumb" data-overview-stage>
              <Screen
                screen={`industry/${d.id}`}
                alt={`${d.title}: sample system interface`}
                sizes="(min-width: 1024px) 32vw, 100vw"
                widths={[480, 800]}
              />
              <div
                class="overview-live"
                data-overview-live
                aria-hidden="true"
                inert
              ></div>
              <p
                class="overview-status"
                data-overview-status
                aria-hidden="true"
              ></p>
              <button
                type="button"
                class="overview-control"
                data-overview-play
                data-overview-url={`/demos/${d.id}.html?preview=1`}
                data-title={d.title}
                data-play-label={copy.play}
                data-stop-label={copy.pause}
                data-replay-label={copy.replay}
                data-still-label={copy.still}
                data-complete-label={copy.complete}
                aria-label={`${copy.play}: ${d.title}`}
                aria-pressed="false"
              >
                <span class="overview-symbol" aria-hidden="true">
                  ▶
                </span>
                <span data-overview-label>{copy.play}</span>
              </button>
            </div>
            <div class="industry-card-body">
              <p class="industry-category">{d.industry}</p>
              <h3>{d.title}</h3>
              <p>{d.summary}</p>
              <ul class="industry-capabilities" role="list">
                {d.capabilities.map((c) => (
                  <li>
                    <Icon name="shield-check" />
                    {c}
                  </li>
                ))}
              </ul>
              <noscript>
                <a class="overview-fallback" href={`/demos/${d.id}.html`}>
                  {copy.fallback}
                </a>
              </noscript>
            </div>
          </li>
        ))}
      </ul>
      <div class="industry-footer">
        <p>{copy.note}</p>
        <a href="#systems">
          {copy.modules}
          <Icon name="arrow-right" />
        </a>
      </div>
    </Container>
  </section>
)}
