---
import mobileVideoUrl from '../../assets/video/arm-exploded-mobile.mp4?url';
/**
 * Robotics centrepiece (PLAN-v2 §4): a robotic arm that loops while its scene is visible.
 * Media, best available first:
 *   1. video  src/assets/video/arm-exploded.(mp4|webm) → native visible-only playback
 *   2. photos robotics/hero-arm + robotics/arm-exploded → a compositor-driven photo loop
 *   3. neither yet → placeholders (still laid out, so the page is complete)
 * No JS / reduced motion: both states side by side, static. Lazy: nothing heavy loads before
 * the visitor scrolls near it.
 */
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Photo from '../media/Photo.astro';
import { site } from '../../content/site';

const videos = import.meta.glob<string>(
  '../../assets/video/arm-exploded.{mp4,webm}',
  {
    eager: true,
    query: '?url',
    import: 'default',
  },
);
const videoUrl = Object.entries(videos).sort(
  ([a], [b]) => Number(b.endsWith('.mp4')) - Number(a.endsWith('.mp4')),
)[0]?.[1];
const copy = site.servicePage;
---

<section
  id="engineering"
  class="exploded"
  aria-labelledby="exploded-heading"
  data-exploded
>
  <Container class="exploded-head">
    <div data-reveal="up" data-scroll-start>
      <Eyebrow>Robotics &amp; R&amp;D</Eyebrow>
      <h2 id="exploded-heading">{copy.explodedHeading}</h2>
      <p>{copy.explodedSummary}</p>
    </div>
  </Container>
  <div class="exploded-scroll">
    <div class="exploded-stage">
      <div class="exploded-pair">
        <Photo
          photo="robotics/hero-arm"
          alt="Assembled six-axis robotic arm"
          ratio="5 / 3"
          class="exploded-a"
          sizes="(min-width: 1024px) 80vw, 100vw"
          widths={[800, 1200, 2000]}
        />
        <Photo
          photo="robotics/arm-exploded"
          alt="The same robotic arm in an exploded view, parts separated along their axes"
          ratio="5 / 3"
          class="exploded-b"
          sizes="(min-width: 1024px) 80vw, 100vw"
          widths={[800, 1200, 2000]}
        />
      </div>
      {videoUrl && (
        <video
          class="exploded-video"
          data-exploded-video
          data-src={videoUrl}
          data-mobile-src={mobileVideoUrl}
          muted
          playsinline
          preload="none"
          aria-hidden="true"
        />
      )}
      <div class="exploded-progress" aria-hidden="true">
        <i data-exploded-bar />
      </div>
      <div class="exploded-controls">
        <button
          type="button"
          class="exploded-replay"
          data-arm-toggle
          data-pause-label={copy.pauseArm}
          data-resume-label={copy.resumeArm}
          aria-pressed="false"
          hidden
        >
          {copy.pauseArm}
        </button>
        <button type="button" class="exploded-replay" data-arm-replay hidden>
          <span aria-hidden="true">↻</span>
          {copy.replayArm}
        </button>
      </div>
    </div>
  </div>
</section>
