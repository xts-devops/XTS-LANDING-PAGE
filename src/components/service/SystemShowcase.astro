---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Screen from '../media/Screen.astro';
import type { System } from '../../content/types';
import { site } from '../../content/site';
import { presentation } from '../../content/presentation';
interface Props {
  systems: System[];
  serviceTitle: string;
  slug: string;
}
const { systems, serviceTitle, slug } = Astro.props;
const copy = site.servicePage;
const demo = presentation.demo;
---

<section
  class="section systems"
  id="systems"
  aria-labelledby="systems-heading"
  data-showcase={slug}
>
  <Container>
    <div class="systems-head" data-scroll-start>
      <div>
        <Eyebrow>{serviceTitle}</Eyebrow>
        <h2 id="systems-heading">{demo.heading}</h2>
      </div>
      <p>{demo.hint}</p>
    </div>
    <div class="systems-tabs" data-tablist aria-label={copy.systemsLabel}>
      {systems.map((system) => (
        <button type="button" class="systems-tab" data-tab={system.id}>
          {system.name}
        </button>
      ))}
    </div>
    <div class="systems-panels">
      {systems.map((system) => (
        <article
          class="system-panel"
          id={`system-${system.id}`}
          data-panel={system.id}
          aria-labelledby={`system-${system.id}-title`}
        >
          <div class="system-info">
            <div>
              <h3 id={`system-${system.id}-title`}>{system.name}</h3>
              <p>{system.summary}</p>
            </div>
            <ul class="system-features" role="list">
              {system.features.map((f) => (
                <li>
                  <Icon name="shield-check" />
                  {f}
                </li>
              ))}
            </ul>
          </div>
          <div class="slides" data-slides data-interval="3000">
            <div class="slides-navigation">
              <div class="slide-picker" aria-label={demo.choose} role="group">
                {system.slides.map((slide, i) => (
                  <button
                    type="button"
                    data-slide-index={i}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    aria-controls={`slides-${system.id}`}
                  >
                    <span>{String(i + 1).padStart(2, '0')}</span>
                    {slide.caption.replace('Mobile app: ', '')}
                  </button>
                ))}
              </div>
            </div>
            <div class="slides-stage">
              {system.slides.length > 1 && (
                <button
                  type="button"
                  class="slides-btn slides-prev"
                  data-prev
                  aria-label={copy.prev}
                  aria-controls={`slides-${system.id}`}
                >
                  <Icon name="arrow-right" class="flip" />
                </button>
              )}
              <div
                class="slides-track"
                id={`slides-${system.id}`}
                data-slides-track
                tabindex="0"
                role="region"
                aria-roledescription="carousel"
                aria-label={`${system.name} screens`}
              >
                {system.slides.map((slide, i) => (
                  <figure
                    class="slide"
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${i + 1} ${copy.slideOf} ${system.slides.length}: ${slide.caption}`}
                  >
                    <figcaption class="slide-toolbar">
                      <span>{slide.caption}</span>{' '}
                      <button
                        type="button"
                        class="sample-zoom"
                        data-screen-open
                        data-screen-title={`${system.name} / ${slide.caption}`}
                      >
                        <Icon name="arrow-up-right" />
                        {demo.view}
                      </button>
                    </figcaption>
                    <div class="slide-display">
                      <Screen
                        screen={slide.screen}
                        alt={`${system.name}: ${slide.caption} (sample system)`}
                        device={slide.device}
                      />
                    </div>
                  </figure>
                ))}
              </div>
              {system.slides.length > 1 && (
                <button
                  type="button"
                  class="slides-btn slides-next"
                  data-next
                  aria-label={copy.next}
                  aria-controls={`slides-${system.id}`}
                >
                  <Icon name="arrow-right" />
                </button>
              )}
              {system.slides.length > 1 && (
                <button
                  type="button"
                  class="slides-progress is-timing"
                  data-slides-progress
                  data-resume-label={demo.play.replace('Play', 'Resume')}
                  data-pause-label={demo.pause}
                  aria-label={demo.pause}
                  aria-pressed="false"
                  aria-controls={`slides-${system.id}`}
                  style={`--interval:3000ms;--segments:${system.slides.length}`}
                >
                  <span class="slides-progress-track" aria-hidden="true">
                    <span class="slides-progress-fill" />
                    {system.slides.map((_, i) => (
                      <span
                        class="slides-progress-segment"
                        data-progress-segment
                        data-current={String(i === 0)}
                      />
                    ))}
                  </span>
                </button>
              )}
            </div>
            <span
              class="sr-only"
              aria-live="off"
              aria-atomic="true"
              data-count-label
              data-slide-of={copy.slideOf}
            >
              1 {copy.slideOf} {system.slides.length}
            </span>
            <div class="slides-footer">
              <p class="system-note">{copy.sampleNote}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Container>
  <dialog
    class="screen-dialog"
    data-screen-dialog
    data-lenis-prevent
    aria-labelledby="screen-dialog-title"
  >
    <div class="screen-dialog-toolbar">
      <h2 id="screen-dialog-title">{demo.preview}</h2>
      <div>
        <button
          type="button"
          data-preview-zoom
          aria-label={demo.zoom}
          aria-pressed="false"
        >
          100%
        </button>
        <button type="button" data-preview-close autofocus>
          {demo.close}
          <span aria-hidden="true"> ×</span>
        </button>
      </div>
    </div>
    <div class="screen-dialog-canvas" data-lenis-prevent>
      <img data-dialog-image alt="" width="1440" height="900" />
    </div>
  </dialog>
</section>
