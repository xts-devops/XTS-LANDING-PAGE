---
import Section from '../ui/Section.astro';
import Photo from '../media/Photo.astro';
import Icon from '../ui/Icon.astro';
import { services } from '../../content/services';
import { site } from '../../content/site';
import '../../styles/home.css';
---

<Section id="services" {...site.services}>
  <ul class="service-grid" role="list">
    {services.map((service, i) => (
      <li class={`service-tile service-tile-${i}`}>
        <a
          href={`/services/${service.slug}`}
          class="service-link"
          data-reveal="up"
        >
          <Photo
            photo={service.photo}
            alt={service.photoAlt}
            ratio="4 / 3"
            sizes="(min-width: 901px) 24vw, (min-width: 561px) 45vw, 100vw"
            transition={`svc-${service.slug}`}
          />
          <div class="service-body">
            <span class="service-index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 style={`view-transition-name:svc-title-${service.slug}`}>
              {service.title}
            </h3>
            <p>{service.tagline}</p>
            <span class="service-cta">
              {site.services.cta} {service.title}
              <Icon name="arrow-up-right" />
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Section>
