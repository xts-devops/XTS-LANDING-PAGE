---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../media/Photo.astro';
import HeroWorkspace from './HeroWorkspace.astro';
import { proof, site } from '../../content/site';
import { heroDirection as direction } from '../../content/hero';
import '../../styles/hero.css';
---

<section id="top" class="hero" aria-labelledby="hero-heading" data-hero>
  <div class="hero-stage">
    <div class="hero-visual" role="group" aria-label={direction.label}>
      <div class="hero-photo-frame">
        <Photo
          photo="home/hero-studio-v3"
          alt={direction.imageAlt}
          ratio="auto"
          class="hero-studio"
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 761px) 100vw, 100vw"
          formats={['webp']}
          eager
        >
          <HeroWorkspace />
        </Photo>
      </div>
    </div>
    <Container class="hero-main">
      <div class="hero-copy">
        <Eyebrow>{site.hero.eyebrow}</Eyebrow>
        <h1 id="hero-heading">
          {site.hero.lines.map((line) => (
            <span class="hero-line">{line} </span>
          ))}
          <span class="hero-emphasis">{site.hero.emphasis}</span>
        </h1>
        <p class="hero-summary">{site.hero.summary}</p>
        <div class="hero-actions">
          <Button href="#contact">{site.hero.primaryCta}</Button>
          <Button href="#services" variant="outline">
            {site.hero.secondaryCta}
          </Button>
        </div>
        <ol class="hero-delivery" aria-label={direction.deliveryLabel}>
          {direction.delivery.map((step, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {step}
            </li>
          ))}
        </ol>
      </div>
      <div class="hero-photo-caption">
        <p>{direction.frameTitle}</p>
        <small>{direction.imageNote}</small>
      </div>
    </Container>
    <button
      class="hero-motion"
      type="button"
      data-workspace-toggle
      data-pause-label={direction.workspace.pause}
      data-resume-label={direction.workspace.resume}
      aria-pressed="false"
      hidden
    >
      <span aria-hidden="true">Ⅱ</span>
      <span data-workspace-toggle-label>{direction.workspace.pause}</span>
    </button>
  </div>
  <Container class="hero-footer">
    <nav class="hero-capabilities" aria-label={direction.indexLabel}>
      {direction.capabilities.map((c) => (
        <a href={`/services/${c.slug}`}>
          <span class="capability-number">{c.number}</span>
          <span>
            <strong>{c.title}</strong>
            <small>{c.detail}</small>
          </span>
          <Icon name="arrow-up-right" />
        </a>
      ))}
    </nav>
    <dl class="hero-proof">
      {proof.map((item) => (
        <div
          class:list={['proof-item', { 'proof-count': item.kind === 'count' }]}
        >
          <dt>{item.label}</dt>
          <dd {...(item.kind === 'count' ? { 'data-count': '' } : {})}>
            {item.value}
            {item.kind === 'count' && item.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
