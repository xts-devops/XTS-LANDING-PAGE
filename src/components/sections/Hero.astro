---
import ProductStage from '../service/ProductStage.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { proof, site } from '../../content/site';
import '../../styles/hero.css';
---

<section id="top" class="hero" aria-labelledby="hero-heading" data-hero>
  <Container class="hero-inner">
    <div class="hero-main">
      <div class="hero-copy">
        <div data-hero-part="eyebrow">
          <Eyebrow>{site.hero.eyebrow}</Eyebrow>
        </div>
        <h1 id="hero-heading" data-hero-part="title">
          {site.hero.lines.map((line) => (
            <span class="hero-line">{line} </span>
          ))}{' '}
          <span class="hero-emphasis">{site.hero.emphasis}</span>
        </h1>
        <p class="hero-summary" data-hero-part="copy">
          {site.hero.summary}
        </p>
        <div class="hero-actions" data-hero-part="copy">
          <Button href="#contact">{site.hero.primaryCta}</Button>
          <Button href="#services" variant="outline">
            {site.hero.secondaryCta}
          </Button>
        </div>
      </div>
      <ProductStage />
    </div>
    <dl class="hero-proof">
      {proof.map((item) => (
        <div
          class:list={['proof-item', { 'proof-count': item.kind === 'count' }]}
        >
          <dt>{item.label}</dt>
          <dd {...(item.kind === 'count' ? { 'data-count': '' } : {})}>
            {item.value}
            {item.kind === 'count' && item.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </Container>
</section>
