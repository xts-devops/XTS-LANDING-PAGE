---
import '../../styles/header.css';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import BrandLogo from '../ui/BrandLogo.astro';
import { navigation, site } from '../../content/site';
const onHome = Astro.url.pathname === '/';
const base = onHome ? '' : '/';
---

<header class="site-header">
  <Container class="header-inner">
    <a
      href={onHome ? '#top' : '/'}
      aria-label={site.homeLabel}
      class="brand-link"
    >
      <BrandLogo eager />
    </a>
    <nav class="desktop-nav" aria-label={site.navLabel}>
      {navigation.map(({ href, label }) => (
        <a
          href={base + href}
          aria-current={
            !onHome &&
            href === '#services' &&
            Astro.url.pathname.startsWith('/services/')
              ? 'page'
              : undefined
          }
        >
          {label}
        </a>
      ))}
    </nav>
    <Button href={`${base}#contact`} variant="outline" class="header-cta">
      {site.buildCta}
    </Button>
    <details class="mobile-menu">
      <summary aria-controls="mobile-navigation">
        {site.menuLabel}
        <span aria-hidden="true">+</span>
      </summary>
      <nav id="mobile-navigation" aria-label={site.navLabel}>
        {navigation.map(({ href, label }) => (
          <a href={base + href}>{label}</a>
        ))}
      </nav>
    </details>
  </Container>
</header>
