---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import Visual from '../ui/Visual.astro';
import { pillars } from '../../content/pillars';
import { site } from '../../content/site';
import '../../styles/solutions.css';
---

<Section id="solutions" {...site.solutions}>
  <div class="solutions-grid">
    {pillars.map((pillar, index) => (
      <Card class="solution-card">
        <Visual
          art={pillar.art}
          image={pillar.image}
          sizes="(min-width: 900px) 40vw, 100vw"
        />
        <div class="solution-content">
          <div class="solution-title">
            <Icon name={pillar.icon} />
            <h3>{pillar.title}</h3>
            <span class="solution-index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <p>{pillar.summary}</p>
          <ul class="solution-chips">
            {pillar.chips.map((chip) => (
              <li>
                <Chip>{chip}</Chip>
              </li>
            ))}
          </ul>
        </div>
      </Card>
    ))}
  </div>
  <p class="solutions-support">
    <Icon name="shield-check" />
    {site.solutions.support}
  </p>
</Section>
