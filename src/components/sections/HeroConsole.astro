---
/**
 * Hero "living console": the four XTS capabilities wired to one hub, with data moving between
 * them, a health/throughput panel and a quiet event feed. Decorative (aria-hidden); copy comes
 * from content. Choreographed by scripts/motion/hero.ts via [data-hero-part].
 */
import { site } from '../../content/site';
import '../../styles/console.css';

const c = site.hero.console;
// Spokes from hub (200,150) to four nodes; paths reused for the travelling dashes.
const nodes = [
  { x: 62, y: 52, label: c.nodes[0] },
  { x: 338, y: 52, label: c.nodes[1] },
  { x: 62, y: 248, label: c.nodes[2] },
  { x: 338, y: 248, label: c.nodes[3] },
].map((n) => ({
  ...n,
  d: `M200 150 C ${n.x < 200 ? 150 : 250} 150 ${n.x < 200 ? n.x + 40 : n.x - 40} ${n.y} ${n.x} ${n.y}`,
}));
const bars = [42, 58, 50, 72, 64, 86, 78, 94];
---

<div class="console" aria-hidden="true" data-hero-part="console">
  <div class="console-bar">
    <span class="console-dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="console-title">{c.title}</span>
    <span class="console-live">
      <i></i>
      {c.status}
    </span>
  </div>

  <div class="console-body">
    <div class="console-graph">
      <svg
        class="sx"
        viewBox="0 0 400 300"
        preserveAspectRatio="xMidYMid meet"
        focusable="false"
      >
        <defs>
          <pattern
            id="console-grid"
            width="20"
            height="20"
            patternUnits="userSpaceOnUse"
          >
            <path class="sx-grid" d="M20 0H0V20"></path>
          </pattern>
        </defs>
        <rect
          width="400"
          height="300"
          fill="url(#console-grid)"
          opacity="0.5"
        ></rect>
        {nodes.map((n, i) => (
          <g data-hero-part="spoke" style={`--i:${i}`}>
            <path class="sx-soft" d={n.d} pathLength="1" data-draw />
            <path class="sx-flow" pathLength="100" d={n.d} />
          </g>
        ))}
        <circle class="sx-tint sx-pulse" cx="200" cy="150" r="30"></circle>
        <circle
          class="sx-hub"
          cx="200"
          cy="150"
          r="32"
          data-hero-part="hub"
        ></circle>
        <text class="console-hub" x="200" y="155" text-anchor="middle">
          {c.hub}
        </text>
        {nodes.map((n, i) => (
          <g data-hero-part="node" style={`--i:${i}`}>
            <rect
              class="sx-node"
              x={n.x - 50}
              y={n.y - 17}
              width="100"
              height="34"
              rx="9"
            />
            <circle class="sx-ink" cx={n.x - 34} cy={n.y} r="3.5" />
            <text class="sx-label" x={n.x - 24} y={n.y + 3.5}>
              {n.label.toUpperCase()}
            </text>
          </g>
        ))}
      </svg>
    </div>

    <div class="console-side">
      <div class="console-card" data-hero-part="card">
        <p class="console-label">{c.throughput}</p>
        <div class="console-bars">
          {bars.map((h, i) => (
            <span style={`--h:${h}%;--i:${i}`}></span>
          ))}
        </div>
      </div>
      <div class="console-card" data-hero-part="card">
        <p class="console-label">{c.health}</p>
        <svg
          class="sx console-spark"
          viewBox="0 0 160 40"
          preserveAspectRatio="none"
          focusable="false"
        >
          <path
            class="sx-tint"
            d="M0 30 L20 26 L40 28 L60 18 L80 22 L100 12 L120 15 L140 8 L160 10 V40 H0 Z"
          ></path>
          <path
            class="sx-gold"
            pathLength="1"
            data-draw
            style="--i:4"
            d="M0 30 L20 26 L40 28 L60 18 L80 22 L100 12 L120 15 L140 8 L160 10"
          ></path>
        </svg>
        <ul class="console-checks">
          {c.checks.map(([name, state]) => (
            <li>
              <i />
              <span>{name}</span>
              <b>{state}</b>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="console-feed" data-hero-part="feed">
    <ul>
      {[...c.feed, ...c.feed].map(([time, text]) => (
        <li>
          <time>{time}</time>
          <span>{text}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
