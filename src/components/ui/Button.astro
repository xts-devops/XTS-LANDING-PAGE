---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'text';
  class?: string;
  label?: string;
}
const { href, variant = 'primary', class: className, label } = Astro.props;
---

<a
  href={href}
  class:list={['button', `button-${variant}`, className]}
  aria-label={label}
>
  <slot />
  <Icon name="arrow-up-right" />
</a>
