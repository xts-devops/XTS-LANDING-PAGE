---
/**
 * Media slot for cards and panels: renders the supplied photo (optimised by astro:assets)
 * or, until one exists, the coded schematic. Keeps the layout's aspect-ratio rules via `.placeholder`.
 */
import { Picture } from 'astro:assets';
import Schematic from '../art/Schematic.astro';
import type { ArtName, Img } from '../../content/types';

interface Props {
  art: ArtName;
  image?: Img;
  class?: string;
  /** Responsive `sizes` hint for photos. */
  sizes?: string;
}
const {
  art,
  image,
  class: className,
  sizes = '(min-width: 1024px) 50vw, 100vw',
} = Astro.props;
---

<div class:list={['placeholder', 'visual', className]} data-reveal="clip">
  {image ? (
    <Picture
      src={image.src}
      alt={image.alt}
      formats={['avif', 'webp']}
      sizes={sizes}
      widths={[480, 800, 1200, 1600]}
    />
  ) : (
    <Schematic name={art} />
  )}
</div>
