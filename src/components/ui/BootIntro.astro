---
import { Image } from 'astro:assets';
import mark from '../../assets/brand/mark-gold-transparent.png';
import { heroDirection } from '../../content/hero';
import '../../styles/boot.css';
const copy = heroDirection.boot;
---

<div class="boot-screen" data-boot-screen role="region" aria-label={copy.label}>
  <div class="boot-light-field" aria-hidden="true">
    <i></i>
    <i></i>
  </div>
  <svg
    class="boot-connections"
    viewBox="0 0 900 500"
    fill="none"
    aria-hidden="true"
  >
    <g class="boot-route boot-route-left">
      <path d="M40 140H200L270 210H350M0 330H180L250 260H345" />
      <circle cx="40" cy="140" r="3" />
      <circle cx="180" cy="330" r="3" />
    </g>
    <g class="boot-route boot-route-right">
      <path d="M860 140H700L630 210H550M900 330H720L650 260H555" />
      <circle cx="860" cy="140" r="3" />
      <circle cx="720" cy="330" r="3" />
    </g>
  </svg>
  <p class="boot-edition" aria-hidden="true">
    {copy.edition}
  </p>
  <div class="boot-signature" aria-hidden="true">
    <div class="boot-emblem">
      <span class="boot-horizon"></span>
      {[0, 1, 2].map((piece) => (
        <span class={`boot-mark-piece boot-mark-piece-${piece}`}>
          <Image
            src={mark}
            alt=""
            width={128}
            height={128}
            format="webp"
            quality={90}
            loading="eager"
          />
        </span>
      ))}
      <Image
        src={mark}
        alt=""
        width={128}
        height={128}
        format="webp"
        quality={90}
        loading="eager"
        class="boot-mark"
      />
    </div>
    <p class="boot-code">{copy.code}</p>
    <p class="boot-name">{copy.name}</p>
    <div class="boot-divider">
      <i></i>
    </div>
    <div class="boot-steps">
      {copy.steps.map((step) => (
        <span>{step}</span>
      ))}
    </div>
    <p class="boot-status">{copy.status}</p>
  </div>
  <button type="button" class="boot-skip" data-boot-skip>
    {copy.skip}
    <span aria-hidden="true"> ↗</span>
  </button>
</div>
