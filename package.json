{
  "name": "xts-landing-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev --host --port 4381",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build",
    "shots": "astro build && playwright test --project=shots",
    "test:e2e": "astro build && playwright test --project=e2e",
    "test:lighthouse": "npx -y @lhci/cli@0.15.1 autorun",
    "serve": "astro build && astro preview --host --port 4380",
    "capture:ui": "node tools/capture-ui.mjs",
    "preview:ui": "node tools/capture-ui.mjs --serve"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@lucide/astro": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
